# ──────────────────────────────────────────────────────────
# Zenthorax Frontend — Environment Variables
# ──────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
#   cp apps/frontend/.env.local.example apps/frontend/.env.local
#
# NEVER commit .env.local to git. It is in .gitignore.
# In production, these are set in: Vercel Dashboard → Settings → Environment Variables
#
# Rules for Next.js public variables:
#   - Name MUST start with NEXT_PUBLIC_ to be available in the browser.
#   - Only put safe values here — they are visible in the client bundle.
#   - NEVER put SUPABASE_SERVICE_ROLE_KEY or JWT_SECRET here.
# ──────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────
# LOCAL:    http://localhost:54321
# PROD:     https://[YOUR_PROJECT_REF].supabase.co
# Find it:  Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321

# Anon/Public key — this is safe to expose. Used for auth, direct DB reads (RLS-protected), and realtime.
# LOCAL:    From `supabase start` output (the "anon key")
# PROD:     Supabase Dashboard → Settings → API → anon/public
# Starts with: eyJ...
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ__CHANGE_ME___________________________________________

# ── Backend API ───────────────────────────────────────────
# LOCAL:    http://localhost:8080
# PROD:     https://zenthorax-api.fly.dev   (or your custom domain: https://api.zenthorax.com)
NEXT_PUBLIC_API_URL=http://localhost:8080
