# ──────────────────────────────────────────────────────────
# Zenthorax Backend — Environment Variables
# ──────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
#   cp apps/backend/.env.example apps/backend/.env
#
# NEVER commit .env to git. It is in .gitignore.
# In production, these are set via: flyctl secrets set KEY=VALUE
# ──────────────────────────────────────────────────────────

# ── Runtime ───────────────────────────────────────────────
# Environment: development | production | test
NODE_ENV=development

# Server port (Fly.io sets PORT=8080 automatically)
PORT=8080

# Bind address (0.0.0.0 to accept all connections, 127.0.0.1 for local-only)
HOST=0.0.0.0

# Log verbosity: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────
# PostgreSQL connection string (Supabase).
# LOCAL:    postgresql://postgres:postgres@localhost:54322/postgres
# PROD:     postgresql://postgres:[YOUR_DB_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# Find it:  Supabase Dashboard → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ── Supabase ──────────────────────────────────────────────
# LOCAL:    http://localhost:54321
# PROD:     https://[YOUR_PROJECT_REF].supabase.co
# Find it:  Supabase Dashboard → Settings → API → Project URL
SUPABASE_URL=http://localhost:54321

# Anon/Public key — safe to expose to client, used for auth + realtime.
# LOCAL:    From `supabase start` output (the "anon key")
# PROD:     Supabase Dashboard → Settings → API → anon/public
# Starts with: eyJ...
SUPABASE_ANON_KEY=eyJ__CHANGE_ME___________________________________________

# Service Role key — BYPASSES Row-Level Security. SERVER-SIDE ONLY.
# LOCAL:    From `supabase start` output (the "service_role key")
# PROD:     Supabase Dashboard → Settings → API → service_role (secret!)
# Starts with: eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ__CHANGE_ME___________________________________

# JWT Secret — used to verify Supabase auth tokens.
# LOCAL:    From `supabase start` output (the "JWT secret")
# PROD:     Supabase Dashboard → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=CHANGE_ME__at_least_32_characters_long_________________

# ── Redis (optional — skip for Phase 0-3) ──────────────────
# Used for: caching (menus, profiles), rate limiting backend, BullMQ job queues.
# LOCAL:    redis://localhost:6379   (or leave blank to skip)
# PROD:     redis://default:[password]@[upstash-endpoint].upstash.io:6379
# Create free tier: https://upstash.com → Redis → Create Database
# REDIS_URL=

# ── Fly.io ─────────────────────────────────────────────────
# Fly app name — auto-detected in production, useful for health checks.
# Set automatically by Fly.io at runtime. Leave empty for local.
# FLY_APP_NAME=zenthorax-api

# ── Error Monitoring (optional) ────────────────────────────
# Sentry DSN for backend error tracking.
# Create free account: https://sentry.io → Create Project → Node.js
# SENTRY_DSN=https://_______________________________________@sentry.io/_______
